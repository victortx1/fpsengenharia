/* SAO JOAO FPS */
/* ========================= */

body::before{
  content:"";
  position:fixed;
  inset:0;

  background:
    radial-gradient(circle at top left,
    rgba(255,140,0,0.12),
    transparent 30%),

    radial-gradient(circle at bottom right,
    rgba(255,200,0,0.08),
    transparent 30%);

  pointer-events:none;
  z-index:-1;
}

/* BADGE */

.saojoao-badge{
  position:fixed;
  top:90px;
  right:25px;

  background:linear-gradient(135deg,#ffcc00,#ff7b00);

  color:#000;

  padding:12px 18px;

  border-radius:999px;

  font-weight:800;

  z-index:999;

  box-shadow:
  0 0 20px rgba(255,200,0,0.5);

  animation:pulseBadge 2s infinite;
}

@keyframes pulseBadge{
  0%{
    transform:scale(1);
  }

  50%{
    transform:scale(1.05);
  }

  100%{
    transform:scale(1);
  }
}

/* LUZES */

.saojoao-lights{
  position:fixed;
  top:0;
  left:0;

  width:100%;

  display:flex;
  justify-content:space-around;

  padding:10px 20px;

  z-index:9999;

  pointer-events:none;
}

.saojoao-lights span{
  width:18px;
  height:18px;

  border-radius:50%;

  animation:piscar 1.2s infinite alternate;
}

.saojoao-lights span:nth-child(1){ background:#ff0000; }
.saojoao-lights span:nth-child(2){ background:#00ff66; }
.saojoao-lights span:nth-child(3){ background:#00c3ff; }
.saojoao-lights span:nth-child(4){ background:#ffcc00; }
.saojoao-lights span:nth-child(5){ background:#ff6600; }
.saojoao-lights span:nth-child(6){ background:#ff00cc; }
.saojoao-lights span:nth-child(7){ background:#ffffff; }
.saojoao-lights span:nth-child(8){ background:#ffe600; }

@keyframes piscar{
  from{
    opacity:0.3;
    transform:translateY(0px);
  }

  to{
    opacity:1;
    transform:translateY(6px);
    box-shadow:0 0 20px currentColor;
  }
}

/* PARTICULAS */

.floating-particles{
  position:fixed;
  inset:0;

  overflow:hidden;

  pointer-events:none;

  z-index:0;
}

.floating-particles span{
  position:absolute;

  width:6px;
  height:6px;

  background:#ffcc00;

  border-radius:50%;

  opacity:0.5;

  animation:particleFloat linear infinite;
}

.floating-particles span:nth-child(1){
  left:10%;
  animation-duration:8s;
}

.floating-particles span:nth-child(2){
  left:25%;
  animation-duration:12s;
}

.floating-particles span:nth-child(3){
  left:40%;
  animation-duration:9s;
}

.floating-particles span:nth-child(4){
  left:55%;
  animation-duration:14s;
}

.floating-particles span:nth-child(5){
  left:70%;
  animation-duration:10s;
}

.floating-particles span:nth-child(6){
  left:85%;
  animation-duration:11s;
}

.floating-particles span:nth-child(7){
  left:95%;
  animation-duration:13s;
}

@keyframes particleFloat{
  from{
    transform:translateY(100vh);
    opacity:0;
  }

  to{
    transform:translateY(-100px);
    opacity:1;
  }
}

/* MINI TAG */

.junina-mini{
  display:inline-block;

  background:rgba(255,200,0,0.1);

  border:1px solid rgba(255,200,0,0.4);

  color:#ffd000;

  padding:10px 18px;

  border-radius:999px;

  margin-bottom:25px;

  font-weight:700;
}

/* HERO */

.hero{
  min-height:85vh;
}

.hero-text h1{
  font-size:58px;
  line-height:1.05;

  margin-bottom:25px;

  background:linear-gradient(90deg,#fff,#ffd000);

  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.hero-text p{
  font-size:18px;
  line-height:1.7;
}

.hero-buttons{
  display:flex;
  gap:15px;
  align-items:center;
  flex-wrap:wrap;
}

/* BOTAO */

.btn-phone{
  background:linear-gradient(135deg,#ffd000,#ff9500);

  color:#000;

  padding:15px 28px;

  border-radius:14px;

  font-weight:800;

  box-shadow:
  0 10px 30px rgba(255,200,0,0.25);

  transition:0.3s;
}

.btn-phone:hover{
  transform:translateY(-4px) scale(1.03);
}

.btn-dark{
  background:#111;

  border:1px solid rgba(255,255,255,0.1);

  padding:15px 24px;

  border-radius:14px;

  color:#fff;
}

/* FOTO */

.hero-image{
  position:relative;
}

.hero-image img{
  width:480px;

  border-radius:28px;

  box-shadow:
  0 0 60px rgba(255,180,0,0.15);
}

/* FOGUEIRA */

.fogueira-icon{
  position:absolute;

  top:-20px;
  right:-20px;

  font-size:60px;

  animation:fogo 2s infinite;
}

@keyframes fogo{
  0%{
    transform:rotate(-3deg) scale(1);
  }

  50%{
    transform:rotate(3deg) scale(1.1);
  }

  100%{
    transform:rotate(-3deg) scale(1);
  }
}

/* RESPONSIVO */

@media(max-width:900px){

  .hero{
    flex-direction:column;
    text-align:center;
    gap:40px;
  }

  .hero-text h1{
    font-size:42px;
  }

  .hero-image img{
    width:100%;
    max-width:380px;
  }

  .saojoao-badge{
    top:80px;
    right:15px;
    font-size:12px;
  }
}
/* ========================= */
/* POPUP SAO JOAO */
/* ========================= */

.saojoao-popup{
  position:fixed;
  inset:0;

  display:flex;
  align-items:center;
  justify-content:center;

  background:rgba(0,0,0,0.55);
  backdrop-filter:blur(6px);

  z-index:999999;

  animation:
  fundoFade 5s forwards;
}

.saojoao-popup img{

  width:420px;
  max-width:85vw;

  animation:
  girarEntrar 2s ease,
  sumirPopup 1s ease forwards;

  animation-delay:
  0s,
  4s;
}

/* ENTRADA */

@keyframes girarEntrar{

  0%{
    opacity:0;
    transform:
    scale(0.2)
    rotate(-720deg);
  }

  60%{
    opacity:1;
    transform:
    scale(1.1)
    rotate(10deg);
  }

  100%{
    opacity:1;
    transform:
    scale(1)
    rotate(0deg);
  }
}

/* SUMIR */

@keyframes sumirPopup{

  to{
    opacity:0;
    transform:
    scale(0.8);
  }
}

/* FUNDO */

@keyframes fundoFade{

  0%{
    opacity:0;
  }

  10%{
    opacity:1;
  }

  85%{
    opacity:1;
  }

  100%{
    opacity:0;
    visibility:hidden;
  }
}
/* ===================================== */
/* COPA DO MUNDO + SAO JOAO FPS PREMIUM */
/* ===================================== */

body::after{
  content:"";
  position:fixed;
  inset:0;

  background:
  radial-gradient(circle at top right,
  rgba(0,180,80,0.10),
  transparent 25%),

  radial-gradient(circle at bottom left,
  rgba(0,120,255,0.08),
  transparent 25%);

  pointer-events:none;
  z-index:-1;
}

/* BANDEIRAS JUNINAS */

.bandeirinhas{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  display:flex;
  justify-content:space-between;
  z-index:99999;
  pointer-events:none;
}

.bandeirinhas span{
  width:60px;
  height:40px;
  clip-path:polygon(50% 100%, 0 0, 100% 0);

  animation:balancar 3s ease-in-out infinite;
}

.bandeirinhas span:nth-child(1){ background:#00ff66; }
.bandeirinhas span:nth-child(2){ background:#ffcc00; }
.bandeirinhas span:nth-child(3){ background:#0099ff; }
.bandeirinhas span:nth-child(4){ background:#ff6600; }
.bandeirinhas span:nth-child(5){ background:#ff0000; }
.bandeirinhas span:nth-child(6){ background:#ffffff; }

@keyframes balancar{
  0%{
    transform:rotate(-3deg);
  }

  50%{
    transform:rotate(3deg);
  }

  100%{
    transform:rotate(-3deg);
  }
}

/* BRILHO COPA */

.copa-glow{
  position:absolute;
  inset:0;

  border-radius:30px;

  box-shadow:
  0 0 40px rgba(0,255,100,0.15),
  0 0 60px rgba(255,220,0,0.10),
  0 0 80px rgba(0,100,255,0.10);

  pointer-events:none;
}

/* ESTRELAS */

.estrelas{
  position:fixed;
  inset:0;
  overflow:hidden;
  pointer-events:none;
  z-index:0;
}

.estrelas span{
  position:absolute;
  color:#fff;
  font-size:12px;
  opacity:0.6;
  animation:estrelaFloat linear infinite;
}

.estrelas span:nth-child(1){
  top:10%;
  left:15%;
  animation-duration:8s;
}

.estrelas span:nth-child(2){
  top:25%;
  left:75%;
  animation-duration:12s;
}

.estrelas span:nth-child(3){
  top:60%;
  left:20%;
  animation-duration:9s;
}

.estrelas span:nth-child(4){
  top:70%;
  left:80%;
  animation-duration:10s;
}

@keyframes estrelaFloat{
  0%{
    transform:translateY(0px) scale(1);
  }

  50%{
    transform:translateY(-10px) scale(1.2);
  }

  100%{
    transform:translateY(0px) scale(1);
  }
}

/* CARD COPA */

.service-card{
  background:
  linear-gradient(
    135deg,
    rgba(0,0,0,0.95),
    rgba(25,25,25,0.95)
  );

  border:1px solid rgba(255,255,255,0.08);

  backdrop-filter:blur(10px);
}

.service-card:hover{
  transform:
  translateY(-10px)
  scale(1.02);

  border-color:#ffd000;

  box-shadow:
  0 0 30px rgba(255,208,0,0.2),
  0 0 60px rgba(0,255,100,0.08);
}

/* HERO PREMIUM */

.hero-text h1{
  text-shadow:
  0 0 15px rgba(255,208,0,0.20),
  0 0 25px rgba(0,255,100,0.10);
}

/* FOTO PRINCIPAL */

.hero-image img{
  border:2px solid rgba(255,208,0,0.15);
}

/* BOTAO PREMIUM */

.btn-dark:hover{
  background:#ffd000;
  color:#000;

  transform:translateY(-4px);

  transition:0.3s;
}

/* WHATSAPP */

.whatsapp-float{
  animation:zapPulse 2s infinite;
}

@keyframes zapPulse{
  0%{
    transform:scale(1);
  }

  50%{
    transform:scale(1.08);
  }

  100%{
    transform:scale(1);
  }
}