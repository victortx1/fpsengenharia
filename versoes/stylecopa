
/* COR PRINCIPAL DO SITE */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, Helvetica, sans-serif;
}

body {
  background: radial-gradient(circle at left, #3a2f00, #000);
  color: #fff;
}



/* RODA PE DE CIMA */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px;
}

.logo {
  font-weight: bold;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* INICIAL SERVIÇOS E CONTATO */
nav a {
  margin: 0 15px;
  color: #ffffff;
  text-decoration: none;
  opacity: 0.8;
}

nav a:hover {
  opacity: 1;
}

.header-buttons button {
  margin-left: 10px;
}

/* SEJA PARECEITO FPS */
.btn-primary {
  background: transparent;
  border: 1px solid #7c6402;
  color: #775f00;
  padding: 8px 14px;
  border-radius: 6px;
  cursor: pointer;
}

/* ENTRA CONTA FPS */ 
.btn-primary {
  background: #f5c400;
  border: none;
  color: #000;
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
}

/* CENTRAL INICIO */
.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60px;
}

.hero-text {
  max-width: 500px;
}

.hero-text h1 {
  font-size: 36px;
  margin-bottom: 20px;
}

.hero-text p {
  opacity: 0.8;
  margin-bottom: 30px;
}

.hero-buttons a {
  margin-right: 10px;
  text-decoration: none;
}

/* BOTAO DE NUMERO E VER SERVIÇOS */
.btn-phone {
  background: #f5c400;
  color: #000;
  padding: 10px 18px;
  border-radius: 8px;
  font-weight: bold;
}

.btn-dark {
  background: #222;
  color: #fff;
  padding: 10px 18px;
  border-radius: 8px;
}

/* AVALIAÇAO PRINCIPAL SO SITE */
.hero-image {
  position: relative;
}

.hero-image img {
  width: 420px;
  border-radius: 20px;
}

.rating {
  position: absolute;
  bottom: -20px;
  left: -20px;
  background: #fff;
  color: #000;
  padding: 12px;
  border-radius: 12px;
  font-size: 14px;
}

/* ANIMAÇÕES SERVIÇOS DA FPS */
[data-animate] {
  opacity: 0;
  transform: translateY(40px);
  transition: all 0.8s ease;
}

[data-animate].active {
  opacity: 1;
  transform: translateY(0);
}

.services {
  padding: 80px 60px;
  text-align: center;
}

.services h2 {
  font-size: 32px;
  margin-bottom: 40px;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.service-card {
  background: #111;
  border: 1px solid #222;
  padding: 30px;
  border-radius: 18px;
  transition: 0.3s;
}

.service-card:hover {
  transform: translateY(-10px);
  border-color: #f5c400;
}

.service-card h3 {
  margin: 15px 0;
}

@media (max-width: 900px) {
  .header {
    flex-direction: column;
    gap: 20px;
  }

  .hero {
    flex-direction: column;
    text-align: center;
  }

  .hero-image img {
    width: 100%;
    max-width: 360px;
  }

  .services-grid {
    grid-template-columns: 1fr;
  }
}

 /* ===== CARROSSEL ===== */

.carrossel-track { 
    display: flex; 
    padding: 40px 0;
    width: calc(250px * 12); /* qtd imagens * largura */
    animation: scroll 25s linear infinite; 
}

.carrossel img { 
    width: 250px; 
    height: 180px; 
    object-fit: cover; 
    border-radius: 12px; 
    margin: 0 10px; 
    box-shadow: 0 4px 8px rgba(0,0,0,0.5); 
}

/* Animação infinita */
@keyframes scroll { 
    0% { transform: translateX(0); } 
    100% { transform: translateX(-50%); } 
}



