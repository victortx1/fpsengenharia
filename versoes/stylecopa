/* CONSERTOS IDENTICO AO DESIGN */
.repairs-box {
  display: flex;
  padding: 2rem;
  align-items: center;
  gap: 80px;
  position: relative;
}

/* FOTO */
.repairs-photo img {
  width: 380px;
  height: 460px;
  object-fit: cover;
  border-radius: 28px;
}

/* TEXTO */
.repairs-info {
  position: relative;
}

.repairs-info::before {
  content: "";
  position: absolute;
  left: -80px;
  top: 40px;
  width: 160px;
  height: 320px;
  background: url("img/eletricista-outline.png") no-repeat center;
  background-size: contain;
  opacity: 0.4;
}

.repairs-info h2 {
  font-size: 40px;
  line-height: 1.1;
  margin-bottom: 25px;
}

.repairs-info ul {
  list-style: none;
}

.repairs-info li {
  font-size: 16px;
  margin-bottom: 12px;
  padding-left: 30px;
  position: relative;
}

.repairs-info li::before {
  content: "✔";
  position: absolute;
  left: 0;
  color: #f5c400;
  font-weight: bold;
}

/* RESPONSIVO AMARELO TOTAL */
@media (max-width: 900px) {
  .repairs-box {
    flex-direction: column;
    text-align: center;
  }

  .repairs-photo img {
    width: 100%;
    max-width: 340px;
    height: auto;
  }

  .repairs-info::before {
    display: none;
  }

  .repairs-info li {
    text-align: left;
  }
}

