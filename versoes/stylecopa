.energy-loader {
  position: fixed;
  inset: 0;
  background: #000;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 99999;
}

.energy-line {
  width: 0;
  height: 4px;
  background: linear-gradient(90deg, transparent, #ffd000, transparent);
  box-shadow: 0 0 20px #ffd000;
  animation: energyMove 1.8s ease-in-out forwards;
}

.energy-loader span {
  margin-top: 25px;
  color: #ffd000;
  letter-spacing: 3px;
  font-size: 0.85rem;
  animation: flicker 1.5s infinite;
}

@keyframes energyMove {
  0% {
    width: 0;
    opacity: 0;
  }
  40% {
    opacity: 1;
  }
  100% {
    width: 70%;
    opacity: 0;
  }
}

@keyframes flicker {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

